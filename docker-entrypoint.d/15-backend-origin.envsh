#!/bin/sh

if [ -z "${BACKEND_ORIGIN:-}" ] && [ -n "${VUE_APP_BACKEND_URL:-}" ]; then
    export BACKEND_ORIGIN="${VUE_APP_BACKEND_URL}"
fi

if [ -z "${BACKEND_ORIGIN:-}" ]; then
    echo 'ERROR: BACKEND_ORIGIN or VUE_APP_BACKEND_URL must be set' >&2
    exit 1
fi

# nginx appends $request_uri, so avoid a double slash.
export BACKEND_ORIGIN="${BACKEND_ORIGIN%/}"
echo "Proxying /backend/ and /images/ to ${BACKEND_ORIGIN}"
