# This project is a Vue 2 / vue-cli 4 app whose dependency graph contains an
# unresolvable peer requirement: vue-chartkick@1.1.0 pulls a peer that resolves
# to vue@3.x while the app is vue@2.6.x. npm 7+ therefore refuses to install at
# all (ERESOLVE), even though the installed tree works — the app has always been
# built with the npm 6 resolver, which ignored peers.
#
# Keep the npm 6 semantics explicitly instead of passing --legacy-peer-deps by
# hand, so `npm ci` works the same locally, in CI, and inside the Dockerfile.
legacy-peer-deps=true
